{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run npm dev",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build CleanCity frontend",
			"type": "shell",
			"command": "npm run build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Diagnose TCP 3001",
			"type": "shell",
			"command": "powershell.exe -NoProfile -Command \"$c=Get-NetTCPConnection -LocalPort 3001 -State Listen -ErrorAction SilentlyContinue; if (!$c) { Write-Output 'NO_LISTENER' } else { foreach ($x in $c) { $p=Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $x.OwningProcess); Write-Output ('PID=' + $p.ProcessId); Write-Output ('NAME=' + $p.Name); Write-Output ('COMMANDLINE=' + $p.CommandLine); Write-Output ('PARENT_PID=' + $p.ParentProcessId) } }\"",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect TCP 3001",
			"type": "shell",
			"command": "$c = Get-NetTCPConnection -LocalPort 3001 -State Listen -ErrorAction SilentlyContinue; if (-not $c) { Write-Output 'NO_LISTENER' } else { foreach ($x in $c) { $p = Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $x.OwningProcess); Write-Output ('PID=' + $p.ProcessId); Write-Output ('NAME=' + $p.Name); Write-Output ('COMMANDLINE=' + $p.CommandLine); Write-Output ('PARENT_PID=' + $p.ParentProcessId) } }",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start CleanCity dev server",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start CleanCity Node server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Verify CleanCity HTTP response",
			"type": "shell",
			"command": "$page = Invoke-WebRequest -Uri http://127.0.0.1:3001/ -UseBasicParsing; Write-Output ('Node-served frontend HTTP ' + $page.StatusCode)",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check CleanCity HTTP response",
			"type": "shell",
			"command": "curl.exe",
			"args": [
				"-I",
				"http://127.0.0.1:3001/"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Git: check and push",
			"type": "shell",
			"command": "git",
			"args": [
				"-C",
				"D:\\bin\\CleanCity",
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "GitHub: verify account and init",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Set-Location 'D:\\bin\\CleanCity'; git init; if (Get-Command gh -ErrorAction SilentlyContinue) { gh auth status } else { 'GH_CLI_NOT_FOUND' }; git status --short --branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Initialize repository",
			"type": "shell",
			"command": "git",
			"args": [
				"-C",
				"D:\\bin\\CleanCity",
				"init"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check GitHub login",
			"type": "shell",
			"command": "gh",
			"args": [
				"auth",
				"status"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Git: commit project",
			"type": "shell",
			"command": "git",
			"args": [
				"-C",
				"D:\\bin\\CleanCity",
				"add",
				"-A"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Git: stage WebSocket changes",
			"type": "shell",
			"command": "git",
			"args": [
				"-C",
				"D:\\bin\\CleanCity",
				"add",
				"-A"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Git: commit WebSocket changes",
			"type": "shell",
			"command": "git",
			"args": [
				"-C",
				"D:\\bin\\CleanCity",
				"-c",
				"user.name=Shadow123-svg",
				"-c",
				"user.email=223556219+Copilot@users.noreply.github.com",
				"commit",
				"-m",
				"Add authenticated WebSocket support",
				"-m",
				"Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Git: push WebSocket commit",
			"type": "shell",
			"command": "git",
			"args": [
				"-C",
				"D:\\bin\\CleanCity",
				"push",
				"origin",
				"HEAD:main"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}